APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# SQL Server CII (default connection untuk app ini)
DB_CII_CONNECTION=cii
DB_CII_HOST=192.168.3.55
DB_CII_PORT=13279
DB_CII_DATABASE=CII
DB_CII_USERNAME=
DB_CII_PASSWORD=
# Timeout login SQL Server (detik) — cegah request API menggantung lama
DB_CII_LOGIN_TIMEOUT=10

# WhatsApp Gateway (Hermes Baileys bridge)
WA_GATEWAY_URL=http://localhost:3000
WA_GATEWAY_TOKEN=
WA_WEBHOOK_SECRET=
WA_BOT_NUMBER=6287731665679

# Approval API — messaging layer (Hermes) ↔ business logic (Laravel).
# Token dipakai messaging layer saat memanggil endpoint /api/approval/*.
APPROVAL_API_TOKEN=
APPROVAL_API_ALLOWED_IPS=
# URL messaging layer (Hermes) yang menerima trigger notifikasi.
# Kosong = mode single-server (Laravel kirim langsung ke bridge lokal).
APPROVAL_NOTIFY_URL=
# Hermes Webhook platform — Laravel POST ke sini agar Hermes langsung
# mengirim notif ke approver (tidak menunggu cron 5 jam).
APPROVAL_WEBHOOK_URL=
# Shared secret — harus sama dengan `hermes webhook subscribe --secret`.
APPROVAL_WEBHOOK_SECRET=

# Throttle anti-ban (jitter + rate limit)
WA_SEND_JITTER_SECONDS=15
WA_SEND_MIN_GAP_SECONDS=15
WA_SEND_MAX_PER_MINUTE=6

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
