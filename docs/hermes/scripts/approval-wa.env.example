# Config messaging layer approval cuti (Hermes side).
# Dibaca oleh ~/.hermes/scripts/approval-*.py
# Salin file ini ke ~/.hermes/approval-wa.env di server Hermes.

# Base URL Laravel API (business logic)
HR_CII_API_URL=http://127.0.0.1:8010

# Bearer token — harus sama dengan APPROVAL_API_TOKEN di .env Laravel
APPROVAL_API_TOKEN=2258b264cb72cb80bc79ddb83b6a6f42d2eafee8289ac940

# WA bridge (Hermes Baileys)
WA_BRIDGE_URL=http://127.0.0.1:3000

# Throttle anti-ban
WA_JITTER_SECONDS=15
WA_MIN_GAP_SECONDS=15
WA_MAX_PER_MINUTE=6